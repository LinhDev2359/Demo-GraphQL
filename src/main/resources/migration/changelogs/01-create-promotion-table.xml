<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="01-create-promotion-table" author="LinhDev">
        <createTable tableName="promotion">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="expired_date" type="DATETIME"/>
            <column name="give_away_day" type="DATETIME"/>
            <column name="discount_percent" type="INT"/>
            <column name="archived_miles" type="BIGINT"/>
            <column name="plus_miles" type="BIGINT"/>
            <column name="quantity" type="BIGINT"/>
            <column name="created_by" type="VARCHAR(255)"/>
            <column name="created_at" type="BIGINT"/>
            <column name="last_updated_by" type="VARCHAR(255)"/>
            <column name="last_updated_at" type="BIGINT"/>
        </createTable>
    </changeSet>
</databaseChangeLog>